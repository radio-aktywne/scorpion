{
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "tamasfe.even-better-toml"],
      "settings": {
        "python.analysis.nodeExecutable": "auto"
      }
    }
  },
  "image": "ghcr.io/radio-aktywne/devcontainers/service-generic:latest",
  "runArgs": [
    "--uts=host",
    "--ipc=host",
    "--network=host",
    "--userns=host",
    "--cgroupns=host",
    "--privileged"
  ]
}
